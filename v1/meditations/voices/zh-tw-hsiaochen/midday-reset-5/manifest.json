{
  "id": "midday-reset-5",
  "voiceId": "zh-tw-hsiaochen",
  "edgeVoice": "zh-TW-HsiaoChenNeural",
  "rate": "-42%",
  "pitch": "-18Hz",
  "totalSec": 140,
  "chunks": [
    {
      "index": 0,
      "text": "歡迎。",
      "file": "c000.ogg",
      "durationSec": 2.592
    },
    {
      "index": 1,
      "text": "找一個舒適的座位，或者如果感覺好一點的話就躺下來。",
      "file": "c001.ogg",
      "durationSec": 9.552
    },
    {
      "index": 2,
      "text": "讓雙手休息一下。",
      "file": "c002.ogg",
      "durationSec": 4.2
    },
    {
      "index": 3,
      "text": "軟化眼睛，或閉上眼睛。",
      "file": "c003.ogg",
      "durationSec": 5.352
    },
    {
      "index": 4,
      "text": "緩慢吸氣。",
      "file": "c004.ogg",
      "durationSec": 3.288
    },
    {
      "index": 5,
      "text": "並且呼氣時間更長。",
      "file": "c005.ogg",
      "durationSec": 4.536
    },
    {
      "index": 6,
      "text": "讓早晨就此結束吧，即使這一天還在繼續。",
      "file": "c006.ogg",
      "durationSec": 8.184
    },
    {
      "index": 7,
      "text": "放下肩膀。",
      "file": "c007.ogg",
      "durationSec": 3.12
    },
    {
      "index": 8,
      "text": "鬆開下巴。",
      "file": "c008.ogg",
      "durationSec": 3.288
    },
    {
      "index": 9,
      "text": "[停頓：30]",
      "file": "c009.ogg",
      "durationSec": 3.912
    },
    {
      "index": 10,
      "text": "透過鼻子吸氣。",
      "file": "c010.ogg",
      "durationSec": 3.864
    },
    {
      "index": 11,
      "text": "透過嘴呼氣，就像霧化窗戶一樣。",
      "file": "c011.ogg",
      "durationSec": 6.72
    },
    {
      "index": 12,
      "text": "再次。",
      "file": "c012.ogg",
      "durationSec": 2.592
    },
    {
      "index": 13,
      "text": "[停頓：30]",
      "file": "c013.ogg",
      "durationSec": 3.912
    },
    {
      "index": 14,
      "text": "想象一下放下你攜帶的任何東西。",
      "file": "c014.ogg",
      "durationSec": 6.576
    },
    {
      "index": 15,
      "text": "它可以在你旁邊的桌子上等待。",
      "file": "c015.ogg",
      "durationSec": 5.976
    },
    {
      "index": 16,
      "text": "[暫停：37]",
      "file": "c016.ogg",
      "durationSec": 4.248
    },
    {
      "index": 17,
      "text": "感覺脊椎挺高。",
      "file": "c017.ogg",
      "durationSec": 3.792
    },
    {
      "index": 18,
      "text": "感覺肚子軟軟的。",
      "file": "c018.ogg",
      "durationSec": 4.08
    },
    {
      "index": 19,
      "text": "[停頓：30]",
      "file": "c019.ogg",
      "durationSec": 3.912
    },
    {
      "index": 20,
      "text": "靜靜地問：接下來的一個小時裡有什麼重要的事情？",
      "file": "c020.ogg",
      "durationSec": 8.736
    },
    {
      "index": 21,
      "text": "明確的下一步就足夠了。",
      "file": "c021.ogg",
      "durationSec": 4.992
    },
    {
      "index": 22,
      "text": "[暫停：44]",
      "file": "c022.ogg",
      "durationSec": 4.272
    },
    {
      "index": 23,
      "text": "呼吸那種簡單。",
      "file": "c023.ogg",
      "durationSec": 3.888
    },
    {
      "index": 24,
      "text": "努力呼氣。",
      "file": "c024.ogg",
      "durationSec": 3.288
    },
    {
      "index": 25,
      "text": "[暫停：37]",
      "file": "c025.ogg",
      "durationSec": 4.248
    },
    {
      "index": 26,
      "text": "再輕鬆地吸一口氣。",
      "file": "c026.ogg",
      "durationSec": 4.488
    },
    {
      "index": 27,
      "text": "動動手指。",
      "file": "c027.ogg",
      "durationSec": 3.264
    },
    {
      "index": 28,
      "text": "準備好後，睜開眼睛。",
      "file": "c028.ogg",
      "durationSec": 5.112
    },
    {
      "index": 29,
      "text": "隨身攜帶一點這個。",
      "file": "c029.ogg",
      "durationSec": 4.296
    }
  ]
}
