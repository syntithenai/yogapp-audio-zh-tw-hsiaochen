{
  "id": "forest-path-10",
  "voiceId": "zh-tw-hsiaochen",
  "edgeVoice": "zh-TW-HsiaoChenNeural",
  "rate": "-42%",
  "pitch": "-18Hz",
  "totalSec": 656,
  "chunks": [
    {
      "index": 0,
      "text": "歡迎。",
      "file": "c000.ogg",
      "durationSec": 2.592
    },
    {
      "index": 1,
      "text": "找到一種對你沒有任何要求的姿勢。",
      "file": "c001.ogg",
      "durationSec": 6.48
    },
    {
      "index": 2,
      "text": "坐下或躺下，根據需要提供任何支撐。",
      "file": "c002.ogg",
      "durationSec": 7.392
    },
    {
      "index": 3,
      "text": "讓雙手張開或柔軟。",
      "file": "c003.ogg",
      "durationSec": 4.632
    },
    {
      "index": 4,
      "text": "讓你的眼睛閉上，或者保持柔和的凝視。",
      "file": "c004.ogg",
      "durationSec": 7.416
    },
    {
      "index": 5,
      "text": "感受身體與地面接觸的地方。",
      "file": "c005.ogg",
      "durationSec": 5.808
    },
    {
      "index": 6,
      "text": "腳跟、坐骨、後腦勺或脊柱的長度。",
      "file": "c006.ogg",
      "durationSec": 7.272
    },
    {
      "index": 7,
      "text": "現在沒什麼可以堅持的。",
      "file": "c007.ogg",
      "durationSec": 5.04
    },
    {
      "index": 8,
      "text": "透過鼻子緩慢吸氣。",
      "file": "c008.ogg",
      "durationSec": 4.512
    },
    {
      "index": 9,
      "text": "感受空氣的涼爽到來。",
      "file": "c009.ogg",
      "durationSec": 4.8
    },
    {
      "index": 10,
      "text": "並且呼氣時間長一點。",
      "file": "c010.ogg",
      "durationSec": 4.776
    },
    {
      "index": 11,
      "text": "感受呼氣離開的溫暖。",
      "file": "c011.ogg",
      "durationSec": 4.68
    },
    {
      "index": 12,
      "text": "再次。輕輕吸氣。",
      "file": "c012.ogg",
      "durationSec": 5.784
    },
    {
      "index": 13,
      "text": "不緊不慢地呼氣。",
      "file": "c013.ogg",
      "durationSec": 3.984
    },
    {
      "index": 14,
      "text": "讓肩膀下降一點。",
      "file": "c014.ogg",
      "durationSec": 4.08
    },
    {
      "index": 15,
      "text": "讓下巴鬆開。",
      "file": "c015.ogg",
      "durationSec": 3.672
    },
    {
      "index": 16,
      "text": "讓肚子變軟。",
      "file": "c016.ogg",
      "durationSec": 3.528
    },
    {
      "index": 17,
      "text": "保持三個安靜的呼吸，就像它們本來的樣子一樣。",
      "file": "c017.ogg",
      "durationSec": 8.496
    },
    {
      "index": 18,
      "text": "吸氣。到達。",
      "file": "c018.ogg",
      "durationSec": 5.04
    },
    {
      "index": 19,
      "text": "呼氣。定居。",
      "file": "c019.ogg",
      "durationSec": 5.064
    },
    {
      "index": 20,
      "text": "如果心走神，請善意地注意它，然後回到呼吸上。",
      "file": "c020.ogg",
      "durationSec": 9.36
    },
    {
      "index": 21,
      "text": "現在開始慢慢走進一片古老的森林。",
      "file": "c021.ogg",
      "durationSec": 6.672
    },
    {
      "index": 22,
      "text": "道路很軟，佈滿了針葉和落葉。",
      "file": "c022.ogg",
      "durationSec": 6.384
    },
    {
      "index": 23,
      "text": "每一步都會發出輕微的聲音，然後又歸於寂靜。",
      "file": "c023.ogg",
      "durationSec": 8.328
    },
    {
      "index": 24,
      "text": "陽光像溫暖的絲帶一樣穿過高高的樹枝。",
      "file": "c024.ogg",
      "durationSec": 7.392
    },
    {
      "index": 25,
      "text": "感受一縷陽光照在你的前臂上——突然的溫和的熱量。",
      "file": "c025.ogg",
      "durationSec": 8.76
    },
    {
      "index": 26,
      "text": "然後再次遮蔭，涼爽、翠綠。",
      "file": "c026.ogg",
      "durationSec": 6.624
    },
    {
      "index": 27,
      "text": "微風吹動樹冠。新鮮空氣撲面而來。",
      "file": "c027.ogg",
      "durationSec": 8.52
    },
    {
      "index": 28,
      "text": "聞到樹脂、潮溼的土壤和苔蘚的乾淨甜味。",
      "file": "c028.ogg",
      "durationSec": 8.136
    },
    {
      "index": 29,
      "text": "暫停。將手掌放在粗糙的樹皮上。",
      "file": "c029.ogg",
      "durationSec": 8.088
    },
    {
      "index": 30,
      "text": "感受樹的寂靜進入你的手中。",
      "file": "c030.ogg",
      "durationSec": 5.52
    },
    {
      "index": 31,
      "text": "繼續深入。外界的聲音逐漸消失。",
      "file": "c031.ogg",
      "durationSec": 7.848
    },
    {
      "index": 32,
      "text": "某處有一條小溪在用明亮的小音節說話。",
      "file": "c032.ogg",
      "durationSec": 7.368
    },
    {
      "index": 33,
      "text": "你跟著直到石頭之間出現水。",
      "file": "c033.ogg",
      "durationSec": 5.808
    },
    {
      "index": 34,
      "text": "跪下。把手浸溼。涼爽的清晰度。",
      "file": "c034.ogg",
      "durationSec": 9.336
    },
    {
      "index": 35,
      "text": "濺一點在手腕上。清新喚醒肌膚。",
      "file": "c035.ogg",
      "durationSec": 7.968
    },
    {
      "index": 36,
      "text": "坐在一塊平坦的岩石上，被狹窄的太陽光柱溫暖著。",
      "file": "c036.ogg",
      "durationSec": 9.0
    },
    {
      "index": 37,
      "text": "感受坐骨和大腿後部的溫暖。",
      "file": "c037.ogg",
      "durationSec": 5.592
    },
    {
      "index": 38,
      "text": "感受溪流清涼的氣息拂過你的小腿。",
      "file": "c038.ogg",
      "durationSec": 6.72
    },
    {
      "index": 39,
      "text": "鳥兒鳴叫一次，然後又離開寧靜。",
      "file": "c039.ogg",
      "durationSec": 6.576
    },
    {
      "index": 40,
      "text": "呼吸森林的清新。",
      "file": "c040.ogg",
      "durationSec": 4.056
    },
    {
      "index": 41,
      "text": "向你周圍的病人軀幹呼氣。",
      "file": "c041.ogg",
      "durationSec": 5.544
    },
    {
      "index": 42,
      "text": "注意你的肩膀是如何在沒有被詢問的情況下下垂的。",
      "file": "c042.ogg",
      "durationSec": 8.568
    },
    {
      "index": 43,
      "text": "當無處可去時，下巴如何軟化。",
      "file": "c043.ogg",
      "durationSec": 6.672
    },
    {
      "index": 44,
      "text": "準備好後站起來，再走遠一點。",
      "file": "c044.ogg",
      "durationSec": 6.312
    },
    {
      "index": 45,
      "text": "蕨類植物用清涼的綠色指尖輕撫你的小腿。",
      "file": "c045.ogg",
      "durationSec": 7.56
    },
    {
      "index": 46,
      "text": "一片空地出現了——圓得像屏住呼吸一樣。",
      "file": "c046.ogg",
      "durationSec": 7.488
    },
    {
      "index": 47,
      "text": "躺在深深的苔蘚上。",
      "file": "c047.ogg",
      "durationSec": 4.44
    },
    {
      "index": 48,
      "text": "地球完全承受你的重量。",
      "file": "c048.ogg",
      "durationSec": 5.016
    },
    {
      "index": 49,
      "text": "過濾後的陽光照在臉上的溫暖。",
      "file": "c049.ogg",
      "durationSec": 5.952
    },
    {
      "index": 50,
      "text": "脊椎上的苔蘚清涼。",
      "file": "c050.ogg",
      "durationSec": 4.488
    },
    {
      "index": 51,
      "text": "微風來了，走了，又來了。",
      "file": "c051.ogg",
      "durationSec": 5.784
    },
    {
      "index": 52,
      "text": "保持被生活場所所擁抱的感覺。",
      "file": "c052.ogg",
      "durationSec": 6.264
    },
    {
      "index": 53,
      "text": "安全。安靜的。無需努力即可歸屬。",
      "file": "c053.ogg",
      "durationSec": 9.432
    },
    {
      "index": 54,
      "text": "在這裡緩慢地數五次呼吸，每一次呼吸都要輕柔一些。",
      "file": "c054.ogg",
      "durationSec": 9.504
    },
    {
      "index": 55,
      "text": "再次注意氣味——綠色、潮溼、誠實。",
      "file": "c055.ogg",
      "durationSec": 8.16
    },
    {
      "index": 56,
      "text": "再次注意聲音——幾乎沒有，但這已經足夠了。",
      "file": "c056.ogg",
      "durationSec": 8.328
    },
    {
      "index": 57,
      "text": "如果有一個念頭出現，就讓它像溪流中的一片葉子一樣漂流。",
      "file": "c057.ogg",
      "durationSec": 10.008
    },
    {
      "index": 58,
      "text": "無論陽光到達何處，肌膚都會恢復溫暖。",
      "file": "c058.ogg",
      "durationSec": 7.608
    },
    {
      "index": 59,
      "text": "在那些溫暖絲帶之間的陰涼處恢復涼爽。",
      "file": "c059.ogg",
      "durationSec": 7.272
    },
    {
      "index": 60,
      "text": "你已經向內走得夠遠了。",
      "file": "c060.ogg",
      "durationSec": 4.824
    },
    {
      "index": 61,
      "text": "讓三個緩慢的呼吸將其封印在體內。",
      "file": "c061.ogg",
      "durationSec": 7.008
    },
    {
      "index": 62,
      "text": "離開之前，再次站在溪邊。",
      "file": "c062.ogg",
      "durationSec": 5.928
    },
    {
      "index": 63,
      "text": "觀看清澈的水流圍繞著石頭。",
      "file": "c063.ogg",
      "durationSec": 5.64
    },
    {
      "index": 64,
      "text": "冷空氣從移動表面上升。",
      "file": "c064.ogg",
      "durationSec": 5.256
    },
    {
      "index": 65,
      "text": "溫暖的光線仍然發現你的前臂上有一條條帶。",
      "file": "c065.ogg",
      "durationSec": 7.896
    },
    {
      "index": 66,
      "text": "如果你願意的話，可以倒杯水，弄溼眉毛——在想象中，冷靜而友善。",
      "file": "c066.ogg",
      "durationSec": 12.36
    },
    {
      "index": 67,
      "text": "森林沒有鼓掌。它只是繼續。",
      "file": "c067.ogg",
      "durationSec": 7.08
    },
    {
      "index": 68,
      "text": "那個延續就是一位老師。",
      "file": "c068.ogg",
      "durationSec": 5.088
    },
    {
      "index": 69,
      "text": "在心裡沿著小路安靜地走幾步。",
      "file": "c069.ogg",
      "durationSec": 5.976
    },
    {
      "index": 70,
      "text": "腳下有針。聲音柔和。軟返回。",
      "file": "c070.ogg",
      "durationSec": 9.168
    },
    {
      "index": 71,
      "text": "然而空地的平靜就像儲存的陽光一樣留在胸中。",
      "file": "c071.ogg",
      "durationSec": 8.232
    },
    {
      "index": 72,
      "text": "感受那裡——胸骨後面的溫暖。",
      "file": "c072.ogg",
      "durationSec": 5.928
    },
    {
      "index": 73,
      "text": "鼻孔裡仍感覺清新。",
      "file": "c073.ogg",
      "durationSec": 4.392
    },
    {
      "index": 74,
      "text": "您可以將兩者帶入普通房間。",
      "file": "c074.ogg",
      "durationSec": 5.808
    },
    {
      "index": 75,
      "text": "最後一次透過樹枝抬頭仰望天空中的一枚硬幣。",
      "file": "c075.ogg",
      "durationSec": 8.304
    },
    {
      "index": 76,
      "text": "夠了。",
      "file": "c076.ogg",
      "durationSec": 2.4
    },
    {
      "index": 77,
      "text": "現在讓故事休息一下，繼續感受吧。",
      "file": "c077.ogg",
      "durationSec": 7.032
    },
    {
      "index": 78,
      "text": "呼吸這個地方的新鮮感。",
      "file": "c078.ogg",
      "durationSec": 4.848
    },
    {
      "index": 79,
      "text": "呼氣，感受它的溫暖和安靜。",
      "file": "c079.ogg",
      "durationSec": 6.096
    },
    {
      "index": 80,
      "text": "吸氣。",
      "file": "c080.ogg",
      "durationSec": 2.712
    },
    {
      "index": 81,
      "text": "呼氣。",
      "file": "c081.ogg",
      "durationSec": 2.616
    },
    {
      "index": 82,
      "text": "再次。輕輕吸氣。",
      "file": "c082.ogg",
      "durationSec": 5.784
    },
    {
      "index": 83,
      "text": "長長地呼氣。",
      "file": "c083.ogg",
      "durationSec": 3.6
    },
    {
      "index": 84,
      "text": "感受這個想象世界的地面所支撐的身體。",
      "file": "c084.ogg",
      "durationSec": 7.152
    },
    {
      "index": 85,
      "text": "吸氣。",
      "file": "c085.ogg",
      "durationSec": 2.712
    },
    {
      "index": 86,
      "text": "呼氣。",
      "file": "c086.ogg",
      "durationSec": 2.616
    },
    {
      "index": 87,
      "text": "如果思緒遊離，請回到皮膚上的溫暖。",
      "file": "c087.ogg",
      "durationSec": 7.248
    },
    {
      "index": 88,
      "text": "或者冷卻鼻子裡的空氣。",
      "file": "c088.ogg",
      "durationSec": 5.088
    },
    {
      "index": 89,
      "text": "吸氣。",
      "file": "c089.ogg",
      "durationSec": 2.712
    },
    {
      "index": 90,
      "text": "呼氣。",
      "file": "c090.ogg",
      "durationSec": 2.616
    },
    {
      "index": 91,
      "text": "吸氣。",
      "file": "c091.ogg",
      "durationSec": 2.712
    },
    {
      "index": 92,
      "text": "呼氣。",
      "file": "c092.ogg",
      "durationSec": 2.616
    },
    {
      "index": 93,
      "text": "留下來。軟化。繼續。",
      "file": "c093.ogg",
      "durationSec": 7.896
    },
    {
      "index": 94,
      "text": "吸氣。",
      "file": "c094.ogg",
      "durationSec": 2.712
    },
    {
      "index": 95,
      "text": "呼氣。",
      "file": "c095.ogg",
      "durationSec": 2.616
    },
    {
      "index": 96,
      "text": "又一個簡單的迴圈。",
      "file": "c096.ogg",
      "durationSec": 4.296
    },
    {
      "index": 97,
      "text": "吸氣。",
      "file": "c097.ogg",
      "durationSec": 2.712
    },
    {
      "index": 98,
      "text": "呼氣。",
      "file": "c098.ogg",
      "durationSec": 2.616
    },
    {
      "index": 99,
      "text": "在這種感覺中再停留幾個呼吸。",
      "file": "c099.ogg",
      "durationSec": 6.144
    },
    {
      "index": 100,
      "text": "溫暖。柔軟度。足夠了。",
      "file": "c100.ogg",
      "durationSec": 7.968
    },
    {
      "index": 101,
      "text": "當你需要的時候你可以回到這個地方。",
      "file": "c101.ogg",
      "durationSec": 6.648
    },
    {
      "index": 102,
      "text": "它存在於你的注意力中，而不僅僅是想象中。",
      "file": "c102.ogg",
      "durationSec": 7.92
    },
    {
      "index": 103,
      "text": "開始加深呼吸。",
      "file": "c103.ogg",
      "durationSec": 3.96
    },
    {
      "index": 104,
      "text": "再次感受你周圍的房間。",
      "file": "c104.ogg",
      "durationSec": 5.016
    },
    {
      "index": 105,
      "text": "動動手指。軟化腳趾。",
      "file": "c105.ogg",
      "durationSec": 6.408
    },
    {
      "index": 106,
      "text": "準備好後，睜開眼睛。",
      "file": "c106.ogg",
      "durationSec": 5.112
    },
    {
      "index": 107,
      "text": "再輕鬆地吸一口氣。",
      "file": "c107.ogg",
      "durationSec": 4.488
    },
    {
      "index": 108,
      "text": "將這種平靜帶入接下來發生的一切。",
      "file": "c108.ogg",
      "durationSec": 6.648
    }
  ]
}
