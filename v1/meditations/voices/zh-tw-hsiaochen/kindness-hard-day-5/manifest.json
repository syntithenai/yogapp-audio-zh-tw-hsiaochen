  "chunks": [
    {
      "index": 0,
      "text": "歡迎。",
      "file": "c000.ogg",
      "durationSec": 2.592
    },
    {
      "index": 1,
      "text": "找一個舒適的座位，或者如果感覺好一點的話就躺下來。",
      "file": "c001.ogg",
      "durationSec": 9.552
    },
    {
      "index": 2,
      "text": "讓雙手休息一下。",
      "file": "c002.ogg",
      "durationSec": 4.2
    },
    {
      "index": 3,
      "text": "軟化眼睛，或閉上眼睛。",
      "file": "c003.ogg",
      "durationSec": 5.352
    },
    {
      "index": 4,
      "text": "緩慢吸氣。",
      "file": "c004.ogg",
      "durationSec": 3.288
    },
    {
      "index": 5,
      "text": "並且呼氣時間更長。",
      "file": "c005.ogg",
      "durationSec": 4.536
    },
    {
      "index": 6,
      "text": "你不需要假裝這很容易。",
      "file": "c006.ogg",
      "durationSec": 5.088
    },
    {
      "index": 7,
      "text": "讓疲勞的真相被允許。",
      "file": "c007.ogg",
      "durationSec": 4.752
    },
    {
      "index": 8,
      "text": "[暫停：31]",
      "file": "c008.ogg",
      "durationSec": 4.08
    },
    {
      "index": 9,
      "text": "小心呼吸。",
      "file": "c009.ogg",
      "durationSec": 3.432
    },
    {
      "index": 10,
      "text": "呼氣要求就可以了。",
      "file": "c010.ogg",
      "durationSec": 4.464
    },
    {
      "index": 11,
      "text": "[暫停：31]",
      "file": "c011.ogg",
      "durationSec": 4.08
    },
    {
      "index": 12,
      "text": "今晚願我對自己溫柔一點。",
      "file": "c012.ogg",
      "durationSec": 5.304
    },
    {
      "index": 13,
      "text": "願我安息如我。",
      "file": "c013.ogg",
      "durationSec": 3.696
    },
    {
      "index": 14,
      "text": "[暫停：31]",
      "file": "c014.ogg",
      "durationSec": 4.08
    },
    {
      "index": 15,
      "text": "願明天只問我能給予的。",
      "file": "c015.ogg",
      "durationSec": 4.992
    },
    {
      "index": 16,
      "text": "[暫停：31]",
      "file": "c016.ogg",
      "durationSec": 4.08
    },
    {
      "index": 17,
      "text": "感覺身體受​​到支撐。",
      "file": "c017.ogg",
      "durationSec": 4.416
    },
    {
      "index": 18,
      "text": "這一刻不需要再做任何事了。",
      "file": "c018.ogg",
      "durationSec": 5.448
    },
    {
      "index": 19,
      "text": "[暫停：45]",
      "file": "c019.ogg",
      "durationSec": 4.152
    },
    {
      "index": 20,
      "text": "如果有幫助的話，請把手放在心裡。",
      "file": "c020.ogg",
      "durationSec": 6.984
    },
    {
      "index": 21,
      "text": "你成功了。",
      "file": "c021.ogg",
      "durationSec": 3.192
    },
    {
      "index": 22,
      "text": "[暫停：38]",
      "file": "c022.ogg",
      "durationSec": 4.2
    },
    {
      "index": 23,
      "text": "再輕鬆地吸一口氣。",
      "file": "c023.ogg",
      "durationSec": 4.488
    },
    {
      "index": 24,
      "text": "動動手指。",
      "file": "c024.ogg",
      "durationSec": 3.264
    },
    {
      "index": 25,
      "text": "準備好後，睜開眼睛。",
      "file": "c025.ogg",
      "durationSec": 5.112
    },
    {
      "index": 26,
      "text": "隨身攜帶一點這個。",
      "file": "c026.ogg",
      "durationSec": 4.296
    }
