  "chunks": [
    {
      "index": 0,
      "text": "歡迎。",
      "file": "c000.ogg",
      "durationSec": 2.592
    },
    {
      "index": 1,
      "text": "需要時間到達。",
      "file": "c001.ogg",
      "durationSec": 3.888
    },
    {
      "index": 2,
      "text": "在支撐下坐下或躺下。",
      "file": "c002.ogg",
      "durationSec": 4.968
    },
    {
      "index": 3,
      "text": "如果感覺安全，請閉上眼睛。",
      "file": "c003.ogg",
      "durationSec": 6.096
    },
    {
      "index": 4,
      "text": "感受與地面的接觸。",
      "file": "c004.ogg",
      "durationSec": 4.2
    },
    {
      "index": 5,
      "text": "緩慢吸氣。",
      "file": "c005.ogg",
      "durationSec": 3.288
    },
    {
      "index": 6,
      "text": "呼氣時間更長。",
      "file": "c006.ogg",
      "durationSec": 3.912
    },
    {
      "index": 7,
      "text": "[暫停：27]",
      "file": "c007.ogg",
      "durationSec": 4.128
    },
    {
      "index": 8,
      "text": "再次。",
      "file": "c008.ogg",
      "durationSec": 2.592
    },
    {
      "index": 9,
      "text": "[暫停：27]",
      "file": "c009.ogg",
      "durationSec": 4.128
    },
    {
      "index": 10,
      "text": "讓肩膀下垂。",
      "file": "c010.ogg",
      "durationSec": 3.672
    },
    {
      "index": 11,
      "text": "讓腹部變軟。",
      "file": "c011.ogg",
      "durationSec": 3.384
    },
    {
      "index": 12,
      "text": "[暫停：34]",
      "file": "c012.ogg",
      "durationSec": 4.296
    },
    {
      "index": 13,
      "text": "我們將在更廣泛的範圍內提供善意。",
      "file": "c013.ogg",
      "durationSec": 6.528
    },
    {
      "index": 14,
      "text": "短語是邀請，而不是命令。",
      "file": "c014.ogg",
      "durationSec": 5.496
    },
    {
      "index": 15,
      "text": "[暫停：34]",
      "file": "c015.ogg",
      "durationSec": 4.296
    },
    {
      "index": 16,
      "text": "朝向你自己。",
      "file": "c016.ogg",
      "durationSec": 3.528
    },
    {
      "index": 17,
      "text": "願我平安。",
      "file": "c017.ogg",
      "durationSec": 3.072
    },
    {
      "index": 18,
      "text": "[暫停：27]",
      "file": "c018.ogg",
      "durationSec": 4.128
    },
    {
      "index": 19,
      "text": "願我一切安好。",
      "file": "c019.ogg",
      "durationSec": 3.6
    },
    {
      "index": 20,
      "text": "[暫停：27]",
      "file": "c020.ogg",
      "durationSec": 4.128
    },
    {
      "index": 21,
      "text": "願我活得輕鬆。",
      "file": "c021.ogg",
      "durationSec": 3.696
    },
    {
      "index": 22,
      "text": "[暫停：41]",
      "file": "c022.ogg",
      "durationSec": 4.08
    },
    {
      "index": 23,
      "text": "再次，慢慢地。",
      "file": "c023.ogg",
      "durationSec": 4.152
    },
    {
      "index": 24,
      "text": "願我平安。",
      "file": "c024.ogg",
      "durationSec": 3.072
    },
    {
      "index": 25,
      "text": "願我一切安好。",
      "file": "c025.ogg",
      "durationSec": 3.6
    },
    {
      "index": 26,
      "text": "願我活得輕鬆。",
      "file": "c026.ogg",
      "durationSec": 3.696
    },
    {
      "index": 27,
      "text": "[暫停：69]",
      "file": "c027.ogg",
      "durationSec": 4.176
    },
    {
      "index": 28,
      "text": "想起一個朋友或容易關心的人。",
      "file": "c028.ogg",
      "durationSec": 6.024
    },
    {
      "index": 29,
      "text": "願你平安。",
      "file": "c029.ogg",
      "durationSec": 3.072
    },
    {
      "index": 30,
      "text": "[暫停：27]",
      "file": "c030.ogg",
      "durationSec": 4.128
    },
    {
      "index": 31,
      "text": "願你一切安好。",
      "file": "c031.ogg",
      "durationSec": 3.648
    },
    {
      "index": 32,
      "text": "[暫停：27]",
      "file": "c032.ogg",
      "durationSec": 4.128
    },
    {
      "index": 33,
      "text": "願你生活輕鬆。",
      "file": "c033.ogg",
      "durationSec": 3.792
    },
    {
      "index": 34,
      "text": "[暫停：69]",
      "file": "c034.ogg",
      "durationSec": 4.176
    },
    {
      "index": 35,
      "text": "讓人想起一箇中立的人。一個你幾乎不認識的人。",
      "file": "c035.ogg",
      "durationSec": 9.528
    },
    {
      "index": 36,
      "text": "願你平安。",
      "file": "c036.ogg",
      "durationSec": 3.072
    },
    {
      "index": 37,
      "text": "願你一切安好。",
      "file": "c037.ogg",
      "durationSec": 3.648
    },
    {
      "index": 38,
      "text": "願你生活輕鬆。",
      "file": "c038.ogg",
      "durationSec": 3.792
    },
    {
      "index": 39,
      "text": "[暫停：69]",
      "file": "c039.ogg",
      "durationSec": 4.176
    },
    {
      "index": 40,
      "text": "如果可能的話，請輕鬆地包括一些困難的人。",
      "file": "c040.ogg",
      "durationSec": 7.92
    },
    {
      "index": 41,
      "text": "或者回到你自己身上，如果今天更明智的話。",
      "file": "c041.ogg",
      "durationSec": 8.208
    },
    {
      "index": 42,
      "text": "願你離苦得樂。",
      "file": "c042.ogg",
      "durationSec": 3.696
    },
    {
      "index": 43,
      "text": "[暫停：55]",
      "file": "c043.ogg",
      "durationSec": 3.984
    },
    {
      "index": 44,
      "text": "廣度一切眾生，無論遠近。",
      "file": "c044.ogg",
      "durationSec": 5.544
    },
    {
      "index": 45,
      "text": "願一切眾生皆安。",
      "file": "c045.ogg",
      "durationSec": 4.032
    },
    {
      "index": 46,
      "text": "[暫停：34]",
      "file": "c046.ogg",
      "durationSec": 4.296
    },
    {
      "index": 47,
      "text": "願一切眾生一切安好。",
      "file": "c047.ogg",
      "durationSec": 4.728
    },
    {
      "index": 48,
      "text": "[暫停：34]",
      "file": "c048.ogg",
      "durationSec": 4.296
    },
    {
      "index": 49,
      "text": "願一切眾生生活安逸。",
      "file": "c049.ogg",
      "durationSec": 4.872
    },
    {
      "index": 50,
      "text": "[暫停：82]",
      "file": "c050.ogg",
      "durationSec": 4.104
    },
    {
      "index": 51,
      "text": "回到你自己的身體和呼吸。",
      "file": "c051.ogg",
      "durationSec": 5.568
    },
    {
      "index": 52,
      "text": "在短語的餘輝中休息。",
      "file": "c052.ogg",
      "durationSec": 4.824
    },
    {
      "index": 53,
      "text": "[暫停：150]",
      "file": "c053.ogg",
      "durationSec": 4.464
    },
    {
      "index": 54,
      "text": "沒什麼好強求的。軟度就夠了。",
      "file": "c054.ogg",
      "durationSec": 7.536
    },
    {
      "index": 55,
      "text": "[暫停：137]",
      "file": "c055.ogg",
      "durationSec": 4.68
    },
    {
      "index": 56,
      "text": "[暫停：41]",
      "file": "c056.ogg",
      "durationSec": 4.08
    },
    {
      "index": 57,
      "text": "開始加深呼吸。",
      "file": "c057.ogg",
      "durationSec": 3.96
    },
    {
      "index": 58,
      "text": "在這裡休息。",
      "file": "c058.ogg",
      "durationSec": 3.648
    },
    {
      "index": 59,
      "text": "[暫停：26]",
      "file": "c059.ogg",
      "durationSec": 4.272
    },
    {
      "index": 60,
      "text": "再次感受一下房間。",
      "file": "c060.ogg",
      "durationSec": 4.464
    },
    {
      "index": 61,
      "text": "擺動手指和腳趾。",
      "file": "c061.ogg",
      "durationSec": 4.248
    },
    {
      "index": 62,
      "text": "準備好後，睜開眼睛。",
      "file": "c062.ogg",
      "durationSec": 5.112
    },
    {
      "index": 63,
      "text": "慢慢地進入接下來的事情。",
      "file": "c063.ogg",
      "durationSec": 5.304
    }
  ]
}
